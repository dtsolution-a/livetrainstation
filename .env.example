# Copy these into MilesWeb mPanel → Node.js app → Environment variables
# (or into a .env file next to server.js). Never commit real values.

NODE_ENV=production
SITE_URL=https://livetrainstation.com

# Keep the data OUTSIDE the app folder so deploys can never overwrite it.
# Example: /home/<user>/livetrainstation-data
DATA_DIR=

# First owner account (only used while there are NO users yet).
# If ADMIN_PASSWORD is empty, a random one is written to DATA_DIR/FIRST_RUN.txt
ADMIN_EMAIL=
ADMIN_NAME=Site Owner
ADMIN_PASSWORD=

# Long random string (32+ chars). If empty one is generated into DATA_DIR/secret.key
SESSION_SECRET=

# Cloudflare Turnstile (free bot protection for the admin login)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstream railway data API (only the server talks to it)
RAIL_API_URL=https://squid-app-plx4l.ondigitalocean.app/api

# Set to 0 only if the site is NOT behind Cloudflare / a reverse proxy
TRUST_PROXY=1
MAX_UPLOAD_MB=6
SESSION_HOURS=12
